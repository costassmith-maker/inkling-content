  {
    "id": "tech-jargon-001",
    "deck": "tech-jargon",
    "term": "Idempotent",
    "origin": null,
    "difficulty": 2,
    "tags": [
      "api",
      "reliability"
    ],
    "locales": {
      "en": {
        "definition": "An operation that gives the same result no matter how many times you run it.",
        "example": "Hitting the same DELETE endpoint twice is fine if it's idempotent."
      },
      "ru": {
        "definition": "Операция, которая даёт один и тот же результат, сколько бы раз её ни повторили.",
        "example": "Дважды дёрнуть тот же DELETE-эндпоинт не страшно, если он идемпотентен.",
        "term": "Идемпотентность"
      },
      "ja": {
        "definition": "何回実行しても同じ結果になる操作のこと。",
        "example": "同じDELETEエンドポイントを2回叩いても、冪等なら問題ない。",
        "term": "冪等"
      },
      "ko": {
        "definition": "몇 번을 실행하든 항상 같은 결과를 내는 연산.",
        "example": "멱등성이 보장되면 같은 DELETE 엔드포인트를 두 번 호출해도 문제없다.",
        "term": "멱등성"
      },
      "fr": {
        "definition": "Une opération qui donne le même résultat quel que soit le nombre de fois où on l'exécute.",
        "example": "Appeler deux fois le même endpoint DELETE ne pose pas de problème s'il est idempotent.",
        "term": "Idempotent"
      },
      "es": {
        "definition": "Operación que da el mismo resultado sin importar cuántas veces se ejecute.",
        "example": "Llamar dos veces al mismo endpoint DELETE no causa problemas si es idempotente.",
        "term": "Idempotente"
      }
    }
  },
