  {
    "id": "linguistics-002",
    "deck": "linguistics",
    "term": "Morpheme",
    "origin": null,
    "difficulty": 2,
    "tags": [
      "morphology"
    ],
    "locales": {
      "en": {
        "definition": "The smallest meaningful unit in a language; cannot be divided without losing meaning.",
        "example": "\"Cats\" has two morphemes: \"cat\" + plural \"-s\"."
      },
      "ru": {
        "definition": "Наименьшая значимая единица языка; её нельзя разделить, не потеряв смысл.",
        "example": "В слове «коты» две морфемы: «кот» + окончание мн. ч. «-ы».",
        "term": "Морфема"
      },
      "ja": {
        "definition": "言語における意味をもつ最小単位で、それ以上分けると意味を失う。",
        "example": "「cats」は「cat」と複数を表す「-s」の二つの形態素から成る。",
        "term": "形態素"
      },
      "ko": {
        "definition": "의미를 지니는 가장 작은 언어 단위로, 더 나누면 의미를 잃는다.",
        "example": "\"cats\"는 \"cat\" + 복수 \"-s\"의 두 형태소로 이루어진다.",
        "term": "형태소"
      },
      "fr": {
        "definition": "La plus petite unité porteuse de sens dans une langue ; on ne peut la diviser sans lui ôter sa signification.",
        "example": "« Chats » comporte deux morphèmes : « chat » + le pluriel « -s ».",
        "term": "Morphème"
      },
      "es": {
        "definition": "La unidad mínima con significado de una lengua; no puede dividirse sin perder su sentido.",
        "example": "\"Cats\" tiene dos morfemas: \"cat\" + el plural \"-s\".",
        "term": "Morfema"
      }
    }
  },
  {
