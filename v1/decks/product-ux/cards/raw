  {
    "id": "product-ux-008",
    "deck": "product-ux",
    "term": "Leading question",
    "origin": null,
    "difficulty": 1,
    "tags": [
      "product-ux",
      "research",
      "interviewing"
    ],
    "locales": {
      "en": {
        "definition": "An interview question phrased so that it suggests its own answer, which quietly corrupts the finding.",
        "example": "'Wouldn't one button be easier?' is a leading question — ask what they did last time instead."
      },
      "ru": {
        "definition": "Вопрос, сформулированный так, что подсказывает ответ, и из-за этого находка исследования перестаёт быть честной.",
        "example": "«Ведь одной кнопкой было бы удобнее?» — это наводящий вопрос, ответ в нём уже лежит.",
        "term": "Наводящий вопрос"
      },
      "ja": {
        "definition": "答えを暗に示してしまう聞き方。気づかないうちに調査結果を歪める。",
        "example": "「ボタンは一つが楽ですよね」は誘導質問。前回どうしたかを聞こう。",
        "term": "誘導質問"
      },
      "ko": {
        "definition": "답을 미리 품고 있는 인터뷰 질문으로, 조사 결과를 조용히 망가뜨린다.",
        "example": "「버튼 하나면 더 편하시죠?」는 유도 질문이다. 지난번에 어떻게 하셨는지를 물어야 한다.",
        "term": "유도 질문"
      },
      "fr": {
        "definition": "Question d'entretien tournée de façon à souffler sa propre réponse, ce qui abîme discrètement le résultat.",
        "example": "« Un seul bouton, ce serait plus simple, non ? » : question orientée, la réponse est déjà dedans.",
        "term": "Question orientée"
      },
      "es": {
        "definition": "Pregunta de entrevista formulada de modo que ya sugiere su respuesta, y así estropea el hallazgo sin que se note.",
        "example": "«¿No sería más cómodo con un solo botón?» es una pregunta dirigida: la respuesta ya va dentro.",
        "term": "Pregunta dirigida"
      }
    }
  },
